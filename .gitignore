results/*
!results/.gitkeep

# Exceptions: the finished 1.7B study's data, in git so that a clone can reuse the pipeline
# (docs/new-generator-runbook.md). New runs stay ignored. The EvalPlus ground-truth .pkl files
# (255 MB and 793 MB) are too large for GitHub; `sandbox-setup` makes them again.
!data/evalplus_cache/
data/evalplus_cache/*
!data/evalplus_cache/evalplus/
data/evalplus_cache/evalplus/*
!data/evalplus_cache/evalplus/HumanEvalPlus-v0.1.10.jsonl
!data/evalplus_cache/evalplus/MbppPlus-v0.2.0.jsonl
!results/runs/
results/runs/*
!results/runs/pilot-v1/
!results/runs/pilot-v1b/
!results/runs/main-test-v1/
